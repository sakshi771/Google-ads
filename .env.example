# Google Ads API Credentials
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Google Ads Customer ID (10-digit number, no dashes)
# Found at the top of your Google Ads dashboard
GOOGLE_ADS_CUSTOMER_ID=1234567890

# US Google Ads account Customer ID (same OAuth credentials, different account)
US_GOOGLE_ADS_CUSTOMER_ID=0987654321

# Manager (MCC) account ID that has access to the US client account
# Required if the US account is managed under an MCC — find it in Google Ads > Manager Accounts
US_LOGIN_CUSTOMER_ID=1122334455

# Developer Token from Google Ads > Tools > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# OAuth 2.0 credentials from Google Cloud Console
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# Refresh Token (run `python get_refresh_token.py` to generate this)
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here

# SEMrush API Key (for competitor keyword analysis)
# Find at: semrush.com > Subscription Info > API units
# Requires Guru or Business plan
SEMRUSH_API_KEY=your_semrush_api_key_here

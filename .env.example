# Google Ads API Credentials
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Google Ads Customer ID (10-digit number, no dashes)
# Found at the top of your Google Ads dashboard
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Developer Token from Google Ads > Tools > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# OAuth 2.0 credentials from Google Cloud Console
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# Refresh Token (run `python get_refresh_token.py` to generate this)
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
